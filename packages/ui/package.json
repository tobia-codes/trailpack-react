{
  "name": "@trailpack/react-ui",
  "version": "0.2.0",
  "description": "React component library and vanilla-extract theme for Trailpack projects.",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobia-codes/trailpack-react.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/tobia-codes/trailpack-react/tree/main/packages/ui",
  "bugs": "https://github.com/tobia-codes/trailpack-react/issues",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles.css.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./styles.css": {
      "types": "./styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "dev": "storybook dev -p 6006 --no-open",
    "lint": "oxlint",
    "storybook:build": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@vanilla-extract/recipes": "^0.5.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@trailpack/react-codeconventions": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
